---
interface Props {
  author: string;
  content: string;
  depth: number;
  reactions?: string[];
  timestamp?: string;
}

const {
  author,
  content,
  depth,
  reactions = [],
  timestamp = "1 hour ago",
} = Astro.props;

const isReply = depth > 0;

// Render @mentions as styled links
const renderContent = (text: string) => {
  const parts = text.split(/(@\w+)/g);
  return parts.map((part, i) => {
    if (part.startsWith("@")) {
      return { type: "mention", text: part, key: i };
    }
    return { type: "text", text: part, key: i };
  });
};

const contentParts = renderContent(content);
---

<div
  class:list={["comment-container", "not-content", isReply && "is-reply"]}
  style={`margin-left: ${depth * 24}px`}
>
  <div class="comment-header">
    <div class="avatar">
      {author.charAt(0).toUpperCase()}
    </div>
    <div class="comment-meta">
      <span class="author-name">{author}</span>
      <span class="timestamp">{timestamp}</span>
      {isReply && <span class="reply-pill">Reply</span>}
    </div>
  </div>

  <div class="comment-content">
    {
      contentParts.map((part) =>
        part.type === "mention" ? (
          <a href="#" class="mention">
            {part.text}
          </a>
        ) : (
          <span>{part.text}</span>
        ),
      )
    }
  </div>

  {
    reactions.length > 0 && (
      <div class="reactions">
        {reactions.map((emoji, i) => (
          <button class={`reaction-button ${i === 0 ? "highlighted" : ""}`}>
            <span class="emoji">{emoji}</span>
            <span class="count">{Math.floor(Math.random() * 5) + 1}</span>
          </button>
        ))}
      </div>
    )
  }
</div>

<style>
  .comment-container {
    --comment-bg: var(--sl-color-gray-6);
    --comment-border: var(--sl-color-gray-5);
    --comment-ink: var(--sl-color-text);
    --comment-muted: var(--sl-color-gray-3);
    --comment-accent: var(--sl-color-accent);

    border: 1px solid var(--comment-border);
    border-radius: 16px;
    padding: 14px 16px;
    background: linear-gradient(160deg, var(--sl-color-black), var(--comment-bg));
    font-family: "Manrope", "Segoe UI", sans-serif;
    max-width: 620px;
    margin: 10px auto;
    position: relative;
  }

  .comment-container::before {
    content: "";
    position: absolute;
    left: 14px;
    top: 12px;
    bottom: 12px;
    width: 2px;
    background: color-mix(in srgb, var(--comment-accent) 40%, transparent);
    opacity: 0.25;
  }

  .comment-container.is-reply::before {
    opacity: 0.5;
  }

  .comment-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .avatar {
    width: 28px;
    height: 28px;
    border-radius: 10px;
    background: var(--comment-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sl-color-text-invert);
    font-size: 12px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .comment-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .author-name {
    font-weight: 600;
    font-size: 14px;
    color: var(--comment-ink);
    font-family: "Fraunces", "Iowan Old Style", serif;
  }

  .timestamp {
    font-size: 12px;
    color: var(--comment-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .reply-pill {
    font-size: 11px;
    color: var(--comment-accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--comment-accent) 18%, transparent);
  }

  .comment-content {
    font-size: 14px;
    line-height: 1.55;
    color: var(--comment-ink);
    padding-left: 30px;
  }

  .mention {
    color: var(--comment-accent);
    text-decoration: none;
    font-weight: 600;
  }

  .mention:hover {
    text-decoration: underline;
  }

  .reactions {
    display: flex;
    gap: 6px;
    margin-left: 30px;
    margin-top: 10px;
    flex-wrap: wrap;
  }

  .reaction-button {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border: 1px solid var(--comment-border);
    border-radius: 999px;
    background: var(--sl-color-black);
    cursor: pointer;
    font-size: 12px;
    transition: transform 0.2s ease, border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .reaction-button.highlighted {
    background: color-mix(
      in srgb,
      var(--comment-accent) 20%,
      var(--sl-color-black)
    );
    border-color: color-mix(in srgb, var(--comment-accent) 60%, transparent);
  }

  .reaction-button:hover {
    transform: translateY(-1px);
    border-color: var(--comment-accent);
  }

  .emoji {
    font-size: 13px;
  }

  .count {
    font-size: 11px;
    color: var(--comment-muted);
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .reaction-button {
      transition: none;
    }

    .reaction-button:hover {
      transform: none;
    }
  }
</style>
