---
interface Props {
  reactions: string[];
  counts?: Record<string, number>;
  userReaction?: string;
}

const { reactions, counts = {}, userReaction } = Astro.props;

// Generate count for each reaction if not provided
const getCount = (emoji: string) => {
  if (counts[emoji] !== undefined) {
    return counts[emoji];
  }
  // Generate random count for demo purposes
  return Math.floor(Math.random() * 15) + 1;
};

const isHighlighted = (emoji: string) => {
  return userReaction === emoji;
};
---

<div class="reaction-picker not-content">
  {
    reactions.map((emoji) => (
      <button
        class:list={["reaction-button", isHighlighted(emoji) && "highlighted"]}
      >
        <span class="emoji">{emoji}</span>
        <span class="count">{getCount(emoji)}</span>
      </button>
    ))
  }
</div>

<style>
  .reaction-picker {
    --picker-bg: var(--sl-color-gray-6);
    --picker-border: var(--sl-color-gray-5);
    --picker-ink: var(--sl-color-text);
    --picker-muted: var(--sl-color-gray-3);
    --picker-accent: var(--sl-color-accent);

    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    padding: 12px;
    border-radius: 16px;
    background: linear-gradient(160deg, var(--sl-color-black), var(--picker-bg));
    border: 1px solid var(--picker-border);
    font-family: "Manrope", "Segoe UI", sans-serif;
  }

  .reaction-button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border: 1px solid var(--picker-border);
    border-radius: 999px;
    background: var(--sl-color-black);
    cursor: pointer;
    font-size: 14px;
    transition: transform 0.2s ease, border-color 0.2s ease,
      background-color 0.2s ease;
    min-width: 62px;
    justify-content: center;
  }

  .reaction-button.highlighted {
    background: color-mix(
      in srgb,
      var(--picker-accent) 22%,
      var(--sl-color-black)
    );
    border-color: color-mix(in srgb, var(--picker-accent) 60%, transparent);
  }

  .reaction-button:hover {
    background: color-mix(in srgb, var(--picker-accent) 12%, var(--sl-color-black));
    border-color: var(--picker-accent);
    transform: translateY(-1px);
  }

  .reaction-button.highlighted:hover {
    background: color-mix(
      in srgb,
      var(--picker-accent) 28%,
      var(--sl-color-black)
    );
  }

  .reaction-button:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--picker-accent) 70%, white);
    outline-offset: 2px;
  }

  .emoji {
    font-size: 16px;
    line-height: 1;
  }

  .count {
    font-size: 12px;
    color: var(--picker-muted);
    font-weight: 600;
  }

  .reaction-button.highlighted .count {
    color: var(--picker-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .reaction-button {
      transition: none;
    }

    .reaction-button:hover {
      transform: none;
    }
  }
</style>
