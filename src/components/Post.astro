---
import { seededRandom } from "../utils/random";

interface Event {
  title: string;
  date: string;
  time?: string;
  location?: string;
  description?: string;
  rsvpRequired?: string;
  coverImage?: string;
}

interface Props {
  author: string;
  content: string;
  reactions: string[];
  selectedReaction?: string;
  timestamp?: string;
  commentCount?: number;
  seed?: number;
  image?: string;
  url?: string;
  event?: Event;
}

const {
  author,
  content,
  reactions,
  selectedReaction,
  timestamp = "2 hours ago",
  commentCount = 0,
  seed = 1,
  image,
  url,
  event,
} = Astro.props;

const random = seededRandom(seed);

// Extract YouTube video ID from URL
const getYouTubeEmbedId = (url: string | undefined) => {
  if (!url) return null;
  const match = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&\s]+)/);
  return match ? match[1] : null;
};

// Extract GitHub repo info from URL
const getGitHubRepoInfo = (url: string | undefined) => {
  if (!url) return null;
  const match = url.match(/github\.com\/([^\/]+)\/([^\/\s?#]+)/);
  if (!match) return null;
  return {
    owner: match[1],
    repo: match[2],
    url: `https://github.com/${match[1]}/${match[2]}`,
  };
};

const youtubeId = getYouTubeEmbedId(url);
const githubInfo = getGitHubRepoInfo(url);

// Render @mentions as styled links
const renderContent = (text: string) => {
  const parts = text.split(/(@\w+)/g);
  return parts.map((part) => {
    if (part.startsWith("@")) {
      return { type: "mention", text: part };
    }
    return { type: "text", text: part };
  });
};

const contentParts = renderContent(content);
---

<div class="post-container not-content">
  <div class="post-header">
    <div class="author-block">
      <div class="avatar">
        {author.charAt(0).toUpperCase()}
      </div>
      <div class="author-meta">
        <div class="author-name">{author}</div>
        <div class="author-subtitle">Community post</div>
      </div>
    </div>
    <div class="post-meta">
      <span class="meta-label">Post</span>
      <span class="timestamp">{timestamp}</span>
    </div>
  </div>

  {image && <img src={image} alt="" class="post-image" />}

  {
    youtubeId && (
      <div class="youtube-embed">
        <iframe
          src={`https://www.youtube.com/embed/${youtubeId}`}
          title="YouTube video player"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        />
      </div>
    )
  }

  {
    githubInfo && (
      <a
        href={githubInfo.url}
        class="github-preview"
        target="_blank"
        rel="noopener noreferrer"
      >
        <div class="github-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 16 16"
            fill="currentColor"
          >
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
          </svg>
        </div>
        <div class="github-info">
          <div class="github-owner">{githubInfo.owner}</div>
          <div class="github-repo">{githubInfo.repo}</div>
        </div>
        <div class="github-action">View on GitHub →</div>
      </a>
    )
  }

  {
    event && (
      <div class="event-card">
        {event.coverImage && (
          <img src={event.coverImage} alt="" class="event-cover" />
        )}
        <div class="event-content">
          <div class="event-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
          </div>
          <div class="event-details">
            <div class="event-title">{event.title}</div>
            <div class="event-datetime">
              📅 {event.date}
              {event.time && ` at ${event.time}`}
            </div>
            {event.location && (
              <div class="event-location">📍 {event.location}</div>
            )}
            {event.description && (
              <div class="event-description">{event.description}</div>
            )}
            {event.rsvpRequired && (
              <div class="event-rsvp">RSVP: {event.rsvpRequired}</div>
            )}
          </div>
        </div>
      </div>
    )
  }

  <div class="post-content">
    {
      contentParts.map((part) =>
        part.type === "mention" ? (
          <a href="#" class="mention">
            {part.text}
          </a>
        ) : (
          part.text
        ),
      )
    }
  </div>

  <div class="post-footer">
    {
      reactions?.length > 0 && (
        <div class="reactions">
          {reactions.map((emoji) => (
            <button
              class:list={[
                "reaction-button",
                emoji === selectedReaction && "highlighted",
              ]}
            >
              <span class="emoji">{emoji}</span>
              <span class="count">{random(1, 9)}</span>
            </button>
          ))}
        </div>
      )
    }

    {
      commentCount > 0 && (
        <div class="comment-count">
          💬 {commentCount} {commentCount === 1 ? "comment" : "comments"}
        </div>
      )
    }
  </div>
</div>

<style>
  .post-container {
    --post-bg: var(--sl-color-gray-6);
    --post-border: var(--sl-color-gray-5);
    --post-ink: var(--sl-color-text);
    --post-muted: var(--sl-color-gray-3);
    --post-accent: var(--sl-color-accent);
    --post-surface: var(--sl-color-black);

    border: 1px solid var(--post-border);
    border-radius: 18px;
    padding: 20px;
    background: linear-gradient(160deg, var(--post-surface), var(--post-bg));
    font-family: "Manrope", "Segoe UI", sans-serif;
    max-width: 640px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.18);
  }

  .post-container::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      600px circle at top left,
      color-mix(in srgb, var(--post-accent) 18%, transparent),
      transparent 55%
    );
    opacity: 0.6;
    pointer-events: none;
  }

  .post-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    gap: 12px;
    position: relative;
    z-index: 1;
  }

  .author-block {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .avatar {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: var(--post-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sl-color-text-invert);
    font-size: 15px;
    font-weight: 700;
    box-shadow: 0 6px 16px
      color-mix(in srgb, var(--post-accent) 40%, transparent);
  }

  .author-name {
    font-family: "Fraunces", "Iowan Old Style", serif;
    font-weight: 600;
    font-size: 16px;
    color: var(--post-ink);
    letter-spacing: 0.01em;
  }

  .author-subtitle {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--post-muted);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
  }

  .meta-label {
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 600;
    color: var(--post-accent);
  }

  .timestamp {
    padding: 4px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--post-accent) 20%, transparent);
    color: var(--post-ink);
    font-weight: 600;
  }

  .post-image {
    width: 100%;
    max-width: 640px;
    height: auto;
    border-radius: 14px;
    margin-bottom: 14px;
    display: block;
    border: 1px solid var(--post-border);
  }

  .youtube-embed {
    position: relative;
    width: 100%;
    max-width: 640px;
    padding-bottom: 56.25%;
    margin-bottom: 14px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--post-border);
    background: var(--post-surface);
  }

  .youtube-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 14px;
  }

  .github-preview {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    padding: 14px;
    margin-bottom: 14px;
    border: 1px solid var(--post-border);
    border-radius: 14px;
    background: color-mix(in srgb, var(--post-surface) 70%, var(--post-bg));
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .github-preview:hover {
    transform: translateY(-2px);
    border-color: var(--post-accent);
  }

  .github-icon {
    width: 34px;
    height: 34px;
    color: var(--post-ink);
    flex-shrink: 0;
  }

  .github-icon svg {
    width: 100%;
    height: 100%;
  }

  .github-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .github-owner {
    font-size: 12px;
    color: var(--post-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .github-repo {
    font-size: 15px;
    font-weight: 600;
    color: var(--post-ink);
  }

  .github-action {
    grid-column: 2;
    font-size: 12px;
    color: var(--post-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .event-card {
    border: 1px solid var(--post-border);
    border-radius: 14px;
    margin-bottom: 14px;
    background: color-mix(in srgb, var(--post-surface) 75%, var(--post-bg));
    overflow: hidden;
  }

  .event-cover {
    width: 100%;
    height: auto;
    display: block;
  }

  .event-content {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    padding: 14px;
  }

  .event-icon {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    color: var(--post-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: color-mix(in srgb, var(--post-accent) 14%, transparent);
  }

  .event-icon svg {
    width: 24px;
    height: 24px;
  }

  .event-details {
    flex: 1;
    min-width: 0;
  }

  .event-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--post-ink);
    margin-bottom: 8px;
    font-family: "Fraunces", "Iowan Old Style", serif;
  }

  .event-datetime,
  .event-location {
    font-size: 13px;
    color: var(--post-muted);
    margin-bottom: 4px;
  }

  .event-description {
    font-size: 13px;
    color: var(--post-ink);
    margin-top: 8px;
    line-height: 1.5;
  }

  .event-rsvp {
    font-size: 12px;
    color: var(--post-accent);
    font-weight: 600;
    margin-top: 10px;
    padding: 4px 10px;
    background: color-mix(in srgb, var(--post-accent) 20%, transparent);
    border-radius: 999px;
    display: inline-flex;
  }

  .post-content {
    text-wrap: balance;
    font-size: 15px;
    line-height: 1.55;
    color: var(--post-ink);
    margin-bottom: 14px;
    position: relative;
    z-index: 1;
  }

  .mention {
    color: var(--post-accent);
    text-decoration: none;
    font-weight: 600;
  }

  .mention:hover {
    text-decoration: underline;
  }

  .post-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    position: relative;
    z-index: 1;
  }

  .reactions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .reaction-button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border: 1px solid var(--post-border);
    border-radius: 999px;
    background: var(--post-surface);
    cursor: pointer;
    font-size: 13px;
    transition: transform 0.2s ease, border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .reaction-button.highlighted {
    background: color-mix(in srgb, var(--post-accent) 20%, var(--post-surface));
    border-color: color-mix(in srgb, var(--post-accent) 60%, transparent);
  }

  .reaction-button:hover {
    transform: translateY(-1px);
    border-color: var(--post-accent);
  }

  .reaction-button:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--post-accent) 70%, white);
    outline-offset: 2px;
  }

  .emoji {
    font-size: 15px;
  }

  .count {
    font-size: 12px;
    color: var(--post-muted);
    font-weight: 600;
  }

  .comment-count {
    font-size: 12px;
    color: var(--post-muted);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .reaction-button,
    .github-preview {
      transition: none;
    }

    .reaction-button:hover,
    .github-preview:hover {
      transform: none;
    }
  }
</style>
